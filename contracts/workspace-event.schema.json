{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://originlabs1.github.io/OriginStudio/contracts/workspace-event.schema.json",
  "title": "Origin workspace event",
  "description": "One line of .origin/events.jsonl. Each event commits to its predecessor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "at", "type", "payload", "prev", "hash"],
  "properties": {
    "seq": { "type": "integer", "minimum": 1 },
    "at": { "type": "string", "format": "date-time" },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "prev": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
